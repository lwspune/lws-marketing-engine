    "music:pp005": "node ../reels/tools/music.mjs music/pv-physics-005-adiabatic.json public/pv-physics-005-adiabatic.wav",
    "mix:pp005": "node tools/mix.ts pp005",
    "render:pp005": "remotion render PvPhysics005 ../reels/pv-physics-005-adiabatic.mp4",
    "cover:pp005": "remotion still PvPhysics005Cover ../reels/pv-physics-005-adiabatic-cover.png",
    "music:pc005": "node ../reels/tools/music.mjs music/pv-chem-005-pvt.json public/pv-chem-005-pvt.wav",
