    "cover:pm004": "remotion still PvMaths004Cover ../reels/pv-maths-004-slope-graph-cover.png",
    "music:pm003": "node ../reels/tools/music.mjs music/pv-maths-003-e.json public/pv-maths-003-e.wav",
    "render:pm003": "remotion render PvMaths003 ../reels/pv-maths-003-e.mp4",
    "cover:pm003": "remotion still PvMaths003Cover ../reels/pv-maths-003-e-cover.png",
    "music:sm001": "node ../reels/tools/music.mjs music/sm-r001-umbrella.json public/sm-r001-umbrella.wav",
    "render:sm001": "remotion render SoundMind001 ../soundmind/reels/sm-r001-umbrella.mp4",
    "cover:sm001": "remotion still SoundMind001Cover ../soundmind/reels/sm-r001-umbrella-cover.jpg --image-format=jpeg",
    "music:sm002": "node ../reels/tools/music.mjs music/sm-r002-window.json public/sm-r002-window.wav",
    "render:sm002": "remotion render SoundMind002 ../soundmind/reels/sm-r002-window.mp4",
    "cover:sm002": "remotion still SoundMind002Cover ../soundmind/reels/sm-r002-window-cover.jpg --image-format=jpeg",
    "music:sm003": "node ../reels/tools/music.mjs music/sm-r003-plant.json public/sm-r003-plant.wav",
    "render:sm003": "remotion render SoundMind003 ../soundmind/reels/sm-r003-plant.mp4",
    "cover:sm003": "remotion still SoundMind003Cover ../soundmind/reels/sm-r003-plant-cover.jpg --image-format=jpeg",
    "render:sm003v": "remotion render SoundMind003V ../soundmind/reels/sm-r003v-plant-vivid.mp4",
    "cover:sm003v": "remotion still SoundMind003VCover ../soundmind/reels/sm-r003v-plant-vivid-cover.jpg --image-format=jpeg"
