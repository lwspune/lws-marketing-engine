# Dependencies and build output
node_modules/
.next/
out/
*.tsbuildinfo

# Secrets: never commit (the publisher's .env.example is the template)
.env
.env.*
!.env.example

# Rendered videos are large and re-made from their page:
#   node reels/tools/record.mjs reels/<name>.render.html
reels/*.mp4
# Sound Mind slides, re-made from their batch: node soundmind/render.mjs soundmind/<week>/batch.json
soundmind/*/*.jpg
# Sound Mind reels, re-made in remotion/: npm run music:sm001 && npm run render:sm001 && npm run cover:sm001
soundmind/reels/*.mp4

# Personal Claude Code settings
.claude/settings.local.json
# Remotion's official skill, installed locally (its repo has no licence file, so it isn't redistributed here)
.claude/skills/remotion-markup/

# OS clutter
Thumbs.db
Desktop.ini
.DS_Store
