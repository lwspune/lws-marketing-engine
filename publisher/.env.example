# Copy to .env.local and fill in. .env.local is gitignored: never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Project Settings → Database → Connection string → "Session pooler" (for npm run db:migrate)
DATABASE_URL=
# Database the DB tests use (npm run db:migrate -- --test, then npm test). Every test rolls back.
TEST_DATABASE_URL=

# Shared secret between Supabase pg_cron and /api/cron/publish. Any long random string;
# the same value goes in Vercel's env vars and in Vault as 'publisher_cron_secret'.
CRON_SECRET=

# Meta developer app (developers.facebook.com → your app → App settings → Basic)
META_APP_ID=
META_APP_SECRET=
# Optional: pin the Graph API version
META_GRAPH_VERSION=v24.0
