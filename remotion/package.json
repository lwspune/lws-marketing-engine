{
  "name": "lws-remotion-trial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trial: @lws.pune reels made with Remotion, compared against reels/engine.js.",
  "scripts": {
    "studio": "remotion studio",
    "audio": "remotion ffmpeg -y -i ../reels/nda-maths-005-area.mp4 -vn -c:a copy -f adts public/nda-maths-005-area.aac",
    "render": "remotion render Reel005 out/nda-maths-005-area-remotion.mp4",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "compare:files": "node -e \"const fs=require('fs');fs.copyFileSync('../reels/nda-maths-005-area.mp4','public/nda-maths-005-area.mp4');fs.copyFileSync('out/nda-maths-005-area-remotion.mp4','public/nda-maths-005-area-remotion.mp4')\"",
    "compare": "remotion render Compare005 out/005-old-vs-new.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "@types/node": "24.19.2"
  }
}
