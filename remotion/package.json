    "music:pc003": "node ../reels/tools/music.mjs music/pv-chem-003-avogadro.json public/pv-chem-003-avogadro.wav",
    "render:pc003": "remotion render PvChem003 ../reels/pv-chem-003-avogadro.mp4",
    "cover:pc003": "remotion still PvChem003Cover ../reels/pv-chem-003-avogadro-cover.png",
    "music:pm002": "node ../reels/tools/music.mjs music/pv-maths-002-calculus.json public/pv-maths-002-calculus.wav",
    "render:pm002": "remotion render PvMaths002 ../reels/pv-maths-002-calculus.mp4",
    "cover:pm002": "remotion still PvMaths002Cover ../reels/pv-maths-002-calculus-cover.png",
    "music:pp004": "node ../reels/tools/music.mjs music/pv-physics-004-slope.json public/pv-physics-004-slope.wav",
    "mix:pp004": "node tools/mix.ts pp004",
