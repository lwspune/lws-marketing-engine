{
  "name": "lws-remotion-trial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trial: @lws.pune reels made with Remotion, compared against reels/engine.js.",
  "scripts": {
    "studio": "remotion studio",
    "audio": "remotion ffmpeg -y -i ../reels/nda-maths-005-area.mp4 -vn -c:a copy -f adts public/nda-maths-005-area.aac",
    "render": "remotion render Reel005 out/nda-maths-005-area-remotion.mp4",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "compare:files": "node -e \"const fs=require('fs');fs.copyFileSync('../reels/nda-maths-005-area.mp4','public/nda-maths-005-area.mp4');fs.copyFileSync('out/nda-maths-005-area-remotion.mp4','public/nda-maths-005-area-remotion.mp4')\"",
    "compare": "remotion render Compare005 out/005-old-vs-new.mp4",
    "music:014": "node ../reels/tools/music.mjs music/nda-maths-014-cone.json public/nda-maths-014-cone.wav",
    "render:014": "remotion render Reel014 ../reels/nda-maths-014-cone.mp4",
    "cover:014": "remotion still Reel014Cover ../reels/nda-maths-014-cone-cover.png",
    "music:pv002": "node ../reels/tools/music.mjs music/pv-physics-002-boyle.json public/pv-physics-002-boyle.wav",
    "render:pv002": "remotion render PvPhysics002 ../reels/pv-physics-002-boyle.mp4",
    "cover:pv002": "remotion still PvPhysics002Cover ../reels/pv-physics-002-boyle-cover.png",
    "music:pc002": "node ../reels/tools/music.mjs music/pv-chem-002-families.json public/pv-chem-002-families.wav",
    "render:pc002": "remotion render PvChem002 ../reels/pv-chem-002-families.mp4",
    "cover:pc002": "remotion still PvChem002Cover ../reels/pv-chem-002-families-cover.png",
    "music:pm001": "node ../reels/tools/music.mjs music/pv-maths-001-sin-cos.json public/pv-maths-001-sin-cos.wav",
    "render:pm001": "remotion render PvMaths001 ../reels/pv-maths-001-sin-cos.mp4",
    "cover:pm001": "remotion still PvMaths001Cover ../reels/pv-maths-001-sin-cos-cover.png",
    "music:pp003": "node ../reels/tools/music.mjs music/pv-physics-003-pendulum.json public/pv-physics-003-pendulum.wav",
    "render:pp003": "remotion render PvPhysics003 ../reels/pv-physics-003-pendulum.mp4",
